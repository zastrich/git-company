# GitCompany AI — variáveis de ambiente
#
# Ao CLONAR o repositório, copie este arquivo para .env:
#   cp .env.example .env
#
# No modo npx/global (npx gitcompany-ai deploy), o binário define automaticamente
# DATABASE_URL para ~/.gitcompany/main.db — não é preciso .env.

# Banco SQLite local (modo clone/dev)
DATABASE_URL="file:./main.db"

# Nenhum segredo de agente/LLM/GitHub aqui.
# Política: todos os tokens ficam na base local (tabela CompanySecret),
# gravados pela aplicação (write-only) e nunca lidos de volta.
